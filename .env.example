# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional: only needed if you want to clone private repos
GITHUB_TOKEN=

# Where Chroma stores its local DB
CHROMA_DB_PATH=./chroma_db

# Which Groq model to use (free tier friendly, fast)
GROQ_MODEL=groq/llama-3.1-8b-instant

PORT=8000
